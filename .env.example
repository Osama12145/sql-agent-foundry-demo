# Foundry Agent Service uses Entra ID, not API keys, so there is no secret here.
# Locally you authenticate with `az login`; on App Service, a managed identity
# supplies the same credential with no code change.
PROJECT_ENDPOINT=https://aif-sqlagent-osama.services.ai.azure.com/api/projects/sqlagent
MODEL_DEPLOYMENT_NAME=gpt-5-mini
# Optional: none | minimal | low | medium | high | xhigh. Leave unset to use the
# service default, which measured fastest here. Latency varies a lot run to run,
# so repeat any comparison before trusting it.
# AGENT_REASONING_EFFORT=
DATABASE_PATH=data/retail.db
API_URL=http://127.0.0.1:8000/query
