{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. API (FastAPI on :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "2. Dashboard (Streamlit on :8501)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "frontend/app.py",
        "--server.port",
        "8501",
        "--server.address",
        "127.0.0.1"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (API + Dashboard)",
      "configurations": [
        "1. API (FastAPI on :8000)",
        "2. Dashboard (Streamlit on :8501)"
      ],
      "stopAll": true
    }
  ]
}
